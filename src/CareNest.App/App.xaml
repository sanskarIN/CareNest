<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="CareNest.App.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:CareNest.App.Converters">
  <Application.Resources>
    <ResourceDictionary>
      <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
      <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
      <converters:BytesToSizeConverter x:Key="BytesToSizeConverter" />
      <x:Double x:Key="BodyFontSize">16</x:Double>
      <x:Double x:Key="PageTitleFontSize">28</x:Double>
      <x:Double x:Key="SectionTitleFontSize">20</x:Double>
      <x:Double x:Key="MutedFontSize">13</x:Double>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
        <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
