<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks Condition="'$(CareNestTargetFramework)' == ''">net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(CareNestTargetFramework)' != ''">$(CareNestTargetFramework)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>CareNest.App</RootNamespace>
    <AssemblyName>CareNest.App</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>CareNest</ApplicationTitle>
    <ApplicationId>com.sanskar.carenest</ApplicationId>
    <ApplicationDisplayVersion>1.0.0-rc.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <CareNestShowFundingLink Condition="'$(CareNestShowFundingLink)' == ''">true</CareNestShowFundingLink>
    <CareNestEffectiveFundingLink Condition="'$(CARENEST_STORE_FUNDING_LINK)' != ''">$(CARENEST_STORE_FUNDING_LINK)</CareNestEffectiveFundingLink>
    <CareNestEffectiveFundingLink Condition="'$(CareNestEffectiveFundingLink)' == ''">$(CareNestShowFundingLink)</CareNestEffectiveFundingLink>
  </PropertyGroup>

  <Target Name="ValidateCareNestFundingLinkConfiguration" BeforeTargets="CoreCompile">
    <Error Condition="'$(CareNestShowFundingLink)' != 'true' and '$(CareNestShowFundingLink)' != 'false'"
           Text="CareNestShowFundingLink must be exactly 'true' or 'false'." />
    <Error Condition="'$(CARENEST_STORE_FUNDING_LINK)' != '' and '$(CARENEST_STORE_FUNDING_LINK)' != 'true' and '$(CARENEST_STORE_FUNDING_LINK)' != 'false'"
           Text="CARENEST_STORE_FUNDING_LINK must be exactly 'true' or 'false' when set." />
    <Error Condition="'$(CareNestEffectiveFundingLink)' != 'true' and '$(CareNestEffectiveFundingLink)' != 'false'"
           Text="CareNestEffectiveFundingLink must resolve to exactly 'true' or 'false'." />
    <Message Importance="High"
             Text="CareNest funding surface: requested=$(CareNestShowFundingLink); store=$(CARENEST_STORE_FUNDING_LINK); effective=$(CareNestEffectiveFundingLink)" />
  </Target>

  <ItemGroup>
    <Compile Remove="ViewModels\FundingLinkPolicy.Enabled.cs" />
    <Compile Remove="ViewModels\FundingLinkPolicy.Disabled.cs" />
    <Compile Include="ViewModels\FundingLinkPolicy.Enabled.cs" Condition="'$(CareNestEffectiveFundingLink)' == 'true'" />
    <Compile Include="ViewModels\FundingLinkPolicy.Disabled.cs" Condition="'$(CareNestEffectiveFundingLink)' == 'false'" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(RuntimeIdentifierOverride)' != ''">
    <RuntimeIdentifier>$(RuntimeIdentifierOverride)</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
    <Compile Remove="Platforms\Android\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">
    <Compile Remove="Platforms\iOS\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'maccatalyst'">
    <Compile Remove="Platforms\MacCatalyst\**\*.cs" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'windows'">
    <Compile Remove="Platforms\Windows\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              ForegroundFile="Resources\AppIcon\appiconfg.svg"
              Color="#E8F2EE" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg"
                      Color="#F5FAF8"
                      BaseSize="512,512" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**"
               LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CareNest.Application\CareNest.Application.csproj" />
    <ProjectReference Include="..\CareNest.Domain\CareNest.Domain.csproj" />
    <ProjectReference Include="..\CareNest.Infrastructure\CareNest.Infrastructure.csproj" />
    <ProjectReference Include="..\CareNest.Shared\CareNest.Shared.csproj" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>
</Project>
