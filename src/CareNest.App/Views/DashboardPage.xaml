<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CareNest.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contracts="clr-namespace:CareNest.Application.Contracts;assembly=CareNest.Application"
    xmlns:vm="clr-namespace:CareNest.App.ViewModels"
    x:DataType="vm:DashboardViewModel"
    Title="Home">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="18" MaximumWidthRequest="980">
      <Grid ColumnDefinitions="*,Auto">
        <Label Text="CareNest"
               Style="{StaticResource PageTitle}" />
        <Button Grid.Column="1"
                Text="Refresh"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource SecondaryButton}"
                SemanticProperties.Hint="Refresh local dashboard data" />
      </Grid>

      <Label Text="Local-first medicine, appointment, document, and family-care organization."
             Style="{StaticResource MutedText}" />

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="8">
          <Label Text="Reminder reliability" FontAttributes="Bold" />
          <Label Text="Device permissions, battery optimization, shutdown, force-stop, time-zone changes, or operating-system restrictions can affect reminder delivery. Do not rely on CareNest for emergencies." />
        </VerticalStackLayout>
      </Border>

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Border Style="{StaticResource Card}">
          <VerticalStackLayout>
            <Label Text="{Binding ProfileCount}"
                   FontSize="32"
                   FontAttributes="Bold" />
            <Label Text="Local profiles"
                   Style="{StaticResource MutedText}" />
            <Button Text="Manage"
                    Command="{Binding OpenProfilesCommand}"
                    Style="{StaticResource SecondaryButton}" />
          </VerticalStackLayout>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}">
          <VerticalStackLayout>
            <Label Text="Reports"
                   FontSize="24"
                   FontAttributes="Bold" />
            <Label Text="Export organizational summaries"
                   Style="{StaticResource MutedText}" />
            <Button Text="Open"
                    Command="{Binding OpenReportsCommand}"
                    Style="{StaticResource SecondaryButton}" />
          </VerticalStackLayout>
        </Border>
      </Grid>

      <Label Text="Local caregiver overview" Style="{StaticResource SectionTitle}" />
      <Label Text="A local-only summary across profiles on this device. CareNest never shares these profiles in the background."
             Style="{StaticResource MutedText}" />
      <CollectionView ItemsSource="{Binding CaregiverProfiles}" EmptyView="No local profiles yet.">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="vm:ProfileCareSummary">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
              <VerticalStackLayout Spacing="6">
                <Label Text="{Binding ProfileName}" FontAttributes="Bold" />
                <FlexLayout Wrap="Wrap">
                  <Label Text="{Binding MedicineCount, StringFormat='Medicines: {0}'}" Margin="0,0,16,4" />
                  <Label Text="{Binding UpcomingReminderCount, StringFormat='Upcoming reminders: {0}'}" Margin="0,0,16,4" />
                  <Label Text="{Binding UpcomingAppointmentCount, StringFormat='Upcoming appointments: {0}'}" Margin="0,0,16,4" />
                  <Label Text="{Binding DocumentCount, StringFormat='Documents: {0}'}" Margin="0,0,16,4" />
                  <Label Text="{Binding LowStockCount, StringFormat='Low-stock estimates: {0}'}" Margin="0,0,16,4" />
                </FlexLayout>
                <Label Text="Stock counts are estimates based on user entries; check the actual supply."
                       Style="{StaticResource MutedText}" />
              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <Label Text="Upcoming reminders"
             Style="{StaticResource SectionTitle}" />
      <CollectionView ItemsSource="{Binding UpcomingReminders}"
                      EmptyView="No scheduled reminders in the current horizon.">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="contracts:ReminderPreview">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <Label Text="{Binding MedicineName}"
                       FontAttributes="Bold" />
                <Label Grid.Column="1"
                       Text="{Binding State}"
                       Style="{StaticResource MutedText}" />
                <Label Grid.Row="1"
                       Text="{Binding ProfileName}"
                       Style="{StaticResource MutedText}" />
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding ScheduledUtc, StringFormat='{0:g} UTC'}"
                       Style="{StaticResource MutedText}" />
              </Grid>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <Button Text="Open medication log"
              Command="{Binding OpenLogCommand}"
              Style="{StaticResource SecondaryButton}" />

      <Label Text="Next appointment"
             Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Card}"
              IsVisible="{Binding HasNextAppointment}">
        <VerticalStackLayout>
          <Label Text="{Binding NextAppointment.Title}"
                 FontAttributes="Bold" />
          <Label Text="{Binding NextAppointment.StartsUtc, StringFormat='{0:g} UTC'}" />
          <Label Text="{Binding NextAppointment.Location}"
                 Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
      </Border>
      <Label Text="No upcoming appointment is recorded."
             IsVisible="{Binding HasNextAppointment, Converter={StaticResource InverseBoolConverter}}"
             Style="{StaticResource MutedText}" />

      <Border Style="{StaticResource Card}">
        <VerticalStackLayout>
          <Label Text="Medical limitation" FontAttributes="Bold" />
          <Label Text="CareNest does not diagnose conditions, determine dosage, recommend treatment, replace a doctor or pharmacist, or provide emergency services." />
        </VerticalStackLayout>
      </Border>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
