<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CareNest.App.Views.MedicationLogPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:contracts="clr-namespace:CareNest.Application.Contracts;assembly=CareNest.Application"
    xmlns:domain="clr-namespace:CareNest.Domain.Entities;assembly=CareNest.Domain"
    xmlns:vm="clr-namespace:CareNest.App.ViewModels"
    x:DataType="vm:MedicationLogViewModel"
    Title="Medication log">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="18" MaximumWidthRequest="980">
      <Grid ColumnDefinitions="*,Auto">
        <VerticalStackLayout>
          <Label Text="Medication log" Style="{StaticResource PageTitle}" />
          <Label Text="These are user-entered or user-confirmed organizational records, not a verified clinical record."
                 Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
        <Button Grid.Column="1"
                Text="Refresh"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource SecondaryButton}" />
      </Grid>

      <Label Text="Upcoming actions" Style="{StaticResource SectionTitle}" />
      <CollectionView ItemsSource="{Binding Upcoming}"
                      EmptyView="No upcoming reminder occurrences.">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="contracts:ReminderPreview">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <Label Text="{Binding MedicineName}"
                         FontAttributes="Bold" />
                  <Label Grid.Column="1"
                         Text="{Binding ScheduledUtc, StringFormat='{0:g} UTC'}"
                         Style="{StaticResource MutedText}" />
                </Grid>
                <Label Text="{Binding ProfileName}"
                       Style="{StaticResource MutedText}" />
                <FlexLayout Wrap="Wrap"
                            Direction="Row"
                            JustifyContent="Start">
                  <Button Text="Taken"
                          Margin="0,0,8,8"
                          Command="{Binding x:DataType=vm:MedicationLogViewModel, Source={RelativeSource AncestorType={x:Type vm:MedicationLogViewModel}}, Path=TakenCommand}"
                          CommandParameter="{Binding .}" />
                  <Button Text="Skipped"
                          Margin="0,0,8,8"
                          Style="{StaticResource SecondaryButton}"
                          Command="{Binding x:DataType=vm:MedicationLogViewModel, Source={RelativeSource AncestorType={x:Type vm:MedicationLogViewModel}}, Path=SkippedCommand}"
                          CommandParameter="{Binding .}" />
                  <Button Text="Delayed"
                          Margin="0,0,8,8"
                          Style="{StaticResource SecondaryButton}"
                          Command="{Binding x:DataType=vm:MedicationLogViewModel, Source={RelativeSource AncestorType={x:Type vm:MedicationLogViewModel}}, Path=DelayedCommand}"
                          CommandParameter="{Binding .}" />
                  <Button Text="Snooze 10 min"
                          Margin="0,0,8,8"
                          Style="{StaticResource SecondaryButton}"
                          Command="{Binding x:DataType=vm:MedicationLogViewModel, Source={RelativeSource AncestorType={x:Type vm:MedicationLogViewModel}}, Path=SnoozeCommand}"
                          CommandParameter="{Binding .}" />
                </FlexLayout>
              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <Label Text="History filters and calendar date" Style="{StaticResource SectionTitle}" />
      <Border Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="10">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <VerticalStackLayout>
              <Label Text="Profile" />
              <Picker ItemsSource="{Binding Profiles}"
                      ItemDisplayBinding="{Binding Name, x:DataType=domain:PersonProfile}"
                      SelectedItem="{Binding SelectedProfile}"
                      Title="All profiles" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1">
              <Label Text="Medicine" />
              <Picker ItemsSource="{Binding Medicines}"
                      ItemDisplayBinding="{Binding Name, x:DataType=domain:Medicine}"
                      SelectedItem="{Binding SelectedMedicine}"
                      Title="All medicines" />
            </VerticalStackLayout>
          </Grid>
          <HorizontalStackLayout Spacing="12">
            <Switch IsToggled="{Binding FilterSingleDate}" />
            <Label Text="Filter by calendar date" VerticalTextAlignment="Center" />
          </HorizontalStackLayout>
          <DatePicker Date="{Binding FilterDate}" IsVisible="{Binding FilterSingleDate}" />
          <HorizontalStackLayout Spacing="10">
            <Button Text="Apply filters" Command="{Binding ApplyFilterCommand}" />
            <Button Text="Clear filters" Command="{Binding ClearFilterCommand}" Style="{StaticResource SecondaryButton}" />
          </HorizontalStackLayout>
        </VerticalStackLayout>
      </Border>

      <Label Text="History" Style="{StaticResource SectionTitle}" />
      <CollectionView ItemsSource="{Binding Entries}"
                      EmptyView="No medication log entries yet.">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="vm:MedicationLogRow">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <Label Text="{Binding MedicineName}"
                       FontAttributes="Bold" />
                <Label Grid.Column="1"
                       Text="{Binding Status}" />
                <Label Grid.Row="1"
                       Text="{Binding ProfileName}"
                       Style="{StaticResource MutedText}" />
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding EventUtc, StringFormat='{0:g} UTC'}"
                       Style="{StaticResource MutedText}" />
                <Label Grid.Row="2"
                       Text="{Binding Note}"
                       LineBreakMode="TailTruncation"
                       MaxLines="2" />
                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="6">
                  <Button Text="Edit"
                          Clicked="EditLogClicked"
                          CommandParameter="{Binding .}"
                          Style="{StaticResource SecondaryButton}" />
                  <Button Text="History"
                          Clicked="HistoryClicked"
                          CommandParameter="{Binding .}"
                          Style="{StaticResource SecondaryButton}" />
                </VerticalStackLayout>
              </Grid>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <Border Style="{StaticResource Card}">
        <Label Text="CareNest uses neutral status labels and does not judge adherence. Ask a qualified professional if you have medical questions about missed or changed medicine use." />
      </Border>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
