<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CareNest.App.Views.MedicineEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:domain="clr-namespace:CareNest.Domain.Entities;assembly=CareNest.Domain"
    xmlns:vm="clr-namespace:CareNest.App.ViewModels"
    x:DataType="vm:MedicineEditorViewModel"
    Title="Medicine">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="760">
      <Label Text="Medicine record" Style="{StaticResource PageTitle}" />
      <Border Style="{StaticResource Card}">
        <Label Text="CareNest does not calculate or infer dosage. Enter strength and instruction text exactly as you want it stored, based on guidance from qualified professionals." />
      </Border>

      <Label Text="Profile" />
      <Picker ItemsSource="{Binding Profiles}"
              ItemDisplayBinding="{Binding Name, x:DataType=domain:PersonProfile}"
              SelectedItem="{Binding SelectedProfile}"
              SemanticProperties.Description="Profile for this medicine record" />

      <Label Text="Medicine name" />
      <Entry Text="{Binding Name}" MaxLength="120" />

      <Label Text="Form" />
      <Entry Text="{Binding Form}"
             Placeholder="Tablet, capsule, liquid, or custom"
             MaxLength="80" />

      <Label Text="Strength text (optional)" />
      <Entry Text="{Binding StrengthText}"
             Placeholder="Stored exactly as entered"
             MaxLength="120" />

      <Label Text="Instruction text (optional)" />
      <Editor Text="{Binding InstructionText}"
              Placeholder="User-entered instructions; CareNest does not interpret this text."
              MaxLength="2000" />

      <Label Text="Prescriber notes (optional)" />
      <Editor Text="{Binding PrescriberNotes}" MaxLength="2000" />

      <Label Text="Pharmacy notes (optional)" />
      <Editor Text="{Binding PharmacyNotes}" MaxLength="2000" />

      <Label Text="Prescription attachment (optional)" />
      <Label Text="{Binding PrescriptionLabel}" Style="{StaticResource MutedText}" />
      <FlexLayout Direction="Row" Wrap="Wrap">
        <Button Text="Import prescription"
                Command="{Binding AttachPrescriptionCommand}"
                Style="{StaticResource SecondaryButton}"
                Margin="0,0,8,8" />
        <Button Text="Export prescription"
                Command="{Binding ExportPrescriptionCommand}"
                IsVisible="{Binding HasPrescription}"
                Style="{StaticResource SecondaryButton}"
                Margin="0,0,8,8" />
        <Button Text="Detach"
                Command="{Binding DetachPrescriptionCommand}"
                IsVisible="{Binding HasPrescription}"
                Style="{StaticResource SecondaryButton}"
                Margin="0,0,8,8" />
      </FlexLayout>
      <Label Text="CareNest encrypts imported prescription files and does not interpret their medical content."
             Style="{StaticResource MutedText}" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <VerticalStackLayout>
          <Label Text="Start date" />
          <DatePicker Date="{Binding StartDate}" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Column="1">
          <HorizontalStackLayout>
            <Switch IsToggled="{Binding HasEndDate}" />
            <Label Text="End date"
                   VerticalTextAlignment="Center" />
          </HorizontalStackLayout>
          <DatePicker Date="{Binding EndDate}"
                      IsVisible="{Binding HasEndDate}" />
        </VerticalStackLayout>
      </Grid>

      <Label Text="State" />
      <Picker ItemsSource="{Binding States}"
              SelectedItem="{Binding State}" />

      <Label Text="Optional stock tracking" Style="{StaticResource SectionTitle}" />
      <Label Text="Stock estimates depend on correct entries. Always check the actual supply instead of relying on CareNest."
             Style="{StaticResource MutedText}" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Entry Text="{Binding StockCountText}"
               Keyboard="Numeric"
               Placeholder="Starting quantity" />
        <Entry Grid.Column="1"
               Text="{Binding RefillThresholdText}"
               Keyboard="Numeric"
               Placeholder="Low-stock threshold" />
      </Grid>

      <Label Text="Optional quantity change per marked Taken event" />
      <Entry Text="{Binding StockChangePerTakenEventText}"
             Keyboard="Numeric"
             Placeholder="Example: 1"
             SemanticProperties.Hint="User-entered quantity subtracted only when an occurrence is marked Taken" />
      <Label Text="CareNest never derives this value from strength, form, or instruction text."
             Style="{StaticResource MutedText}" />
      <HorizontalStackLayout Spacing="12">
        <Switch IsToggled="{Binding HasRefillDate}" />
        <Label Text="Track a refill date" VerticalTextAlignment="Center" />
      </HorizontalStackLayout>
      <DatePicker Date="{Binding RefillDate}" IsVisible="{Binding HasRefillDate}" />

      <Label Text="{Binding StatusMessage}"
             TextColor="{StaticResource Danger}" />

      <Button Text="Save"
              Command="{Binding SaveCommand}"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
      <Button Text="Save and edit reminder schedule"
              Command="{Binding SaveAndScheduleCommand}"
              Style="{StaticResource SecondaryButton}"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

      <Button Text="Delete medicine record"
              IsVisible="{Binding IsExisting}"
              Clicked="DeleteClicked"
              Style="{StaticResource DangerButton}" />

      <Button Text="Enter stock correction"
              IsVisible="{Binding IsExisting}"
              Clicked="StockCorrectionClicked"
              Style="{StaticResource SecondaryButton}" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
