<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="CareNest.App.Views.AppointmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CareNest.App.ViewModels"
    x:DataType="vm:AppointmentsViewModel"
    Title="Appointments">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="18" MaximumWidthRequest="920">
      <Grid ColumnDefinitions="*,Auto">
        <VerticalStackLayout>
          <Label Text="Appointments" Style="{StaticResource PageTitle}" />
          <Label Text="Organize dates, locations, questions, preparation notes, and optional reminders."
                 Style="{StaticResource MutedText}" />
        </VerticalStackLayout>
        <Button Grid.Column="1"
                Text="Add"
                Command="{Binding AddCommand}" />
      </Grid>

      <Label Text="Upcoming" Style="{StaticResource SectionTitle}" />
      <CollectionView ItemsSource="{Binding Upcoming}"
                      EmptyView="No upcoming appointments are recorded.">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="vm:AppointmentRow">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <Label Text="{Binding Title}" FontAttributes="Bold" />
                <Label Grid.Column="1"
                       Text="{Binding StartsUtc, StringFormat='{0:g} UTC'}" />
                <Label Grid.Row="1"
                       Text="{Binding ProfileName}"
                       Style="{StaticResource MutedText}" />
                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding ClinicianOrFacility}"
                       Style="{StaticResource MutedText}" />
                <Label Grid.Row="2"
                       Text="{Binding Location}"
                       Style="{StaticResource MutedText}" />
                <Button Grid.Row="2" Grid.Column="1"
                        Text="Edit"
                        Command="{Binding x:DataType=vm:AppointmentsViewModel, Source={RelativeSource AncestorType={x:Type vm:AppointmentsViewModel}}, Path=EditCommand}"
                        CommandParameter="{Binding .}"
                        Style="{StaticResource SecondaryButton}" />
              </Grid>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <Label Text="History" Style="{StaticResource SectionTitle}" />
      <CollectionView ItemsSource="{Binding History}"
                      EmptyView="No past appointments are recorded.">
        <CollectionView.ItemTemplate>
          <DataTemplate x:DataType="vm:AppointmentRow">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
              <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout>
                  <Label Text="{Binding Title}" FontAttributes="Bold" />
                  <Label Text="{Binding StartsUtc, StringFormat='{0:g} UTC'}"
                         Style="{StaticResource MutedText}" />
                  <Label Text="{Binding ProfileName}"
                         Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="View"
                        Command="{Binding x:DataType=vm:AppointmentsViewModel, Source={RelativeSource AncestorType={x:Type vm:AppointmentsViewModel}}, Path=EditCommand}"
                        CommandParameter="{Binding .}"
                        Style="{StaticResource SecondaryButton}" />
              </Grid>
            </Border>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
