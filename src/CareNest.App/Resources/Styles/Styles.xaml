<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

  <Style TargetType="ContentPage">
    <Setter Property="BackgroundColor">
      <Setter.Value>
        <AppThemeBinding Light="{StaticResource BackgroundLight}" Dark="{StaticResource BackgroundDark}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Label">
    <Setter Property="TextColor">
      <Setter.Value>
        <AppThemeBinding Light="{StaticResource TextLight}" Dark="{StaticResource TextDark}" />
      </Setter.Value>
    </Setter>
    <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
  </Style>

  <Style x:Key="PageTitle" TargetType="Label">
    <Setter Property="FontSize" Value="{DynamicResource PageTitleFontSize}" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="Label">
    <Setter Property="FontSize" Value="{DynamicResource SectionTitleFontSize}" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
  </Style>

  <Style x:Key="MutedText" TargetType="Label">
    <Setter Property="FontSize" Value="{DynamicResource MutedFontSize}" />
    <Setter Property="TextColor">
      <Setter.Value>
        <AppThemeBinding Light="{StaticResource MutedLight}" Dark="{StaticResource MutedDark}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button">
    <Setter Property="MinimumHeightRequest" Value="44" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BackgroundColor">
      <Setter.Value>
        <AppThemeBinding Light="{StaticResource BrandPrimary}" Dark="{StaticResource BrandPrimaryDark}" />
      </Setter.Value>
    </Setter>
    <Setter Property="TextColor">
      <Setter.Value>
        <AppThemeBinding Light="White" Dark="#122019" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="BackgroundColor" Value="Transparent" />
    <Setter Property="BorderWidth" Value="1" />
    <Setter Property="BorderColor">
      <Setter.Value>
        <AppThemeBinding Light="{StaticResource OutlineLight}" Dark="{StaticResource OutlineDark}" />
      </Setter.Value>
    </Setter>
    <Setter Property="TextColor">
      <Setter.Value>
        <AppThemeBinding Light="{StaticResource TextLight}" Dark="{StaticResource TextDark}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button">
    <Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
    <Setter Property="TextColor" Value="White" />
  </Style>

  <Style TargetType="Entry">
    <Setter Property="MinimumHeightRequest" Value="44" />
    <Setter Property="TextColor">
      <Setter.Value>
        <AppThemeBinding Light="{StaticResource TextLight}" Dark="{StaticResource TextDark}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Editor">
    <Setter Property="MinimumHeightRequest" Value="88" />
    <Setter Property="TextColor">
      <Setter.Value>
        <AppThemeBinding Light="{StaticResource TextLight}" Dark="{StaticResource TextDark}" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Picker">
    <Setter Property="MinimumHeightRequest" Value="44" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Stroke">
      <Setter.Value>
        <AppThemeBinding Light="{StaticResource OutlineLight}" Dark="{StaticResource OutlineDark}" />
      </Setter.Value>
    </Setter>
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="Background">
      <Setter.Value>
        <AppThemeBinding Light="{StaticResource SurfaceLight}" Dark="{StaticResource SurfaceDark}" />
      </Setter.Value>
    </Setter>
    <Setter Property="Padding" Value="16" />
    <Setter Property="StrokeShape">
      <RoundRectangle CornerRadius="16" />
    </Setter>
  </Style>


  <Style x:Key="WarningCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Stroke" Value="{StaticResource Warning}" />
  </Style>

  <Style TargetType="Switch">
    <Setter Property="MinimumHeightRequest" Value="44" />
  </Style>
</ResourceDictionary>
